    {
      "parameters": {
        "jsCode": "// Check Sends: after every email has been tried, fail loudly if any didn't go out, so e0 emails you.\n// Sits on its own branch BELOW the other one: n8n runs the top branch first, so stamps are saved before this runs.\nconst failMsg = j => j.error ? String(j.error.message || j.error.description || j.error) : (Array.isArray(j.rejected) && j.rejected.length ? 'rejected by the mail server: ' + j.rejected.join(', ') : '');\nconst ANSWERS = 'Doctor Lists';                                 // the node whose items were emailed\nconst answers = $(ANSWERS).all();\nconst sends = $('Send Emails').all();\n\nconst failed = [];\nsends.forEach((s, i) => {\n  const err = failMsg(s.json);\n  if (!err) return;\n  const a = answers[i].json;\n  const who = a.kind === 'attention' ? 'the \"Needs attention\" email' : a.kind === 'doctor' ? `${a.doctor}'s list` : `${a.patient_name} (${a.booking_id})`;\n  failed.push(`${who}: ${err}`);\n});\nif (failed.length) {\n  throw new Error(`${failed.length} of ${sends.length} emails failed to send. ${failed.join(' | ')}`);\n}\nreturn [{ json: { sent: sends.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -90
      ],
      "id": "e4c7beed-3ed0-4912-a882-54011abec731",
      "name": "Check Sends"
    },
    {
      "parameters": {
        "content": "## d4 · Doctors' Morning Lists\nMonday to Saturday at 8 AM (Pakistan time): each doctor gets today's confirmed appointments (time, patient, visit, phone), sorted by time. A doctor with none gets an email saying so; a doctor marked away in Closures but with bookings is flagged.\n\nd0 also checks the whole sheet every morning: unreadable dates or times, unknown doctors, duplicate booking IDs, bad Closures rows. Any found go to you in one \"Needs attention\" email.\n\nIf any email fails, Check Sends stops the run with the names and e0 emails you. To test, set data in Doctor Lists to {{ { test_now: '2026-10-19 08:00' } }}.",
        "width": 900,
        "height": 300,
        "color": 2
      },
